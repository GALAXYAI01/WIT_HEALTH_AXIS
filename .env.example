# Version 2.0 security configuration. Keep the real values in .env only.
WIT_JWT_SECRET=replace-with-a-long-random-secret
WIT_ADMIN_EMAIL=admin@example.org
WIT_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-password
WIT_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
WIT_COOKIE_SECURE=false
WIT_COOKIE_SAMESITE=lax
WIT_ACCESS_TOKEN_MINUTES=30
WIT_SESSION_DAYS=7
WIT_MAX_REQUEST_MB=60
WIT_REQUIRE_AUTH=false
WIT_ALLOW_REGISTRATION=false
# Generate with Fernet.generate_key() before enabling in production.
WIT_FIELD_ENCRYPTION_KEY=
